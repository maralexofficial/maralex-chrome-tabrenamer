{
  "manifest_version": 3,
  "name": "TabRenamer",
  "version": "1.0.0",
  "description": "Give each open browser tab its own custom title.",
  "minimum_chrome_version": "111",
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "TabRenamer",
    "default_popup": "src/popup/popup.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
